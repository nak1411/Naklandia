[sub_resource type="PlaneMesh" id="PlaneMesh_grid"]
size = Vector2(20, 20)

[sub_resource type="Shader" id="Shader_grid"]
code = "shader_type spatial;
render_mode unshaded;

uniform vec4 grid_color : source_color = vec4(0.3, 0.3, 0.3, 1.0);
uniform vec4 axis_x_color : source_color = vec4(1.0, 0.3, 0.3, 1.0);
uniform vec4 axis_z_color : source_color = vec4(0.3, 0.3, 1.0, 1.0);
uniform float grid_scale : hint_range(0.1, 10.0) = 1.0;
uniform float line_width : hint_range(0.001, 0.1) = 0.02;

void fragment() {
	vec2 coord = UV * 20.0 * grid_scale;
	vec2 grid = abs(fract(coord - 0.5) - 0.5) / fwidth(coord);
	float line = min(grid.x, grid.y);

	// Grid alpha
	float grid_alpha = 1.0 - min(line, 1.0);

	// Check if we're on the X axis (Z = 0) - centered on grid
	float z_coord = coord.y - 10.0 * grid_scale;
	float z_grid_line = abs(fract(z_coord) - 0.5) / fwidth(coord.y);
	bool on_x_axis = abs(z_coord) < 0.08;

	// Check if we're on the Z axis (X = 0) - centered on grid
	float x_coord = coord.x - 10.0 * grid_scale;
	float x_grid_line = abs(fract(x_coord) - 0.5) / fwidth(coord.x);
	bool on_z_axis = abs(x_coord) < 0.08;

	vec3 color;
	float alpha;

	if (on_x_axis && grid_alpha > 0.0) {
		color = axis_x_color.rgb;
		alpha = 1.0;
	} else if (on_z_axis && grid_alpha > 0.0) {
		color = axis_z_color.rgb;
		alpha = 1.0;
	} else {
		color = grid_color.rgb;
		alpha = grid_alpha;
	}

	ALBEDO = color;
	ALPHA = alpha;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_grid"]
render_priority = 0
shader = SubResource("Shader_grid")
shader_parameter/grid_color = Color(0.3, 0.3, 0.3, 1)
shader_parameter/axis_x_color = Color(1, 0.3, 0.3, 1)
shader_parameter/axis_z_color = Color(0.3, 0.3, 1, 1)
shader_parameter/grid_scale = 1.0
shader_parameter/line_width = 0.02

[sub_resource type="Shader" id="Shader_gradient_sky"]
code = "shader_type sky;

uniform vec4 top_color : source_color = vec4(0.3, 0.3, 0.4, 1.0);
uniform vec4 bottom_color : source_color = vec4(0.15, 0.15, 0.2, 1.0);

void sky() {
	float y = EYEDIR.y;
	COLOR = mix(bottom_color.rgb, top_color.rgb, clamp(y * 0.5 + 0.5, 0.0, 1.0));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_gradient_sky"]
